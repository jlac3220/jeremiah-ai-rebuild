# Keep this server-side. Never prefix it with VITE_.
OPENAI_API_KEY=

# Fixed Jeremiah narrator uses the same server-side OPENAI_API_KEY.
# Audio is delivered as MP3; clients never choose an OS voice.
# Generating new clips uses paid API credits; existing clips are cached.

# Normal interactions: inexpensive, fast teacher reactions.
JEREMIAH_OPENAI_MODEL_FAST=

# Teach-back and mastery: stronger reasoning/evaluation.
JEREMIAH_OPENAI_MODEL_DEEP=

# Pilot feedback storage. Use a persistent, private volume outside Git when hosted.
# On a Codespace, the default is app/.pilot-data/og1-feedback.jsonl (not durable).
# PILOT_FEEDBACK_FILE=/var/lib/jeremiah/og1-feedback.jsonl

# Deployed pilots are CLOSED unless explicitly configured. Keep verification
# private; never set release approval until all live gates pass.
PILOT_ACCESS_MODE=closed
PILOT_RELEASE_APPROVED=false
# Generate separate random secrets in a password manager; configure server-side.
PILOT_OWNER_USERNAME=owner
PILOT_OWNER_PASSWORD=
PILOT_SESSION_SECRET=
PILOT_INVITE_CODE=

# Persistent atomic Redis REST storage (Vercel Marketplace / Upstash).
# KV_REST_API_URL and KV_REST_API_TOKEN aliases are also supported.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Owner-approved maximum: $10/month. Code rejects larger monthly allowances.
# Reservations use verified prices, not OpenAI project-budget alerts.
PILOT_MONTHLY_BUDGET_CENTS=1000
PILOT_DAILY_BUDGET_CENTS=300
PILOT_MAX_DAILY_PROVIDER_CALLS=100
PILOT_MAX_MONTHLY_PROVIDER_CALLS=1000
# Required before paid requests: map EXACT verified model IDs to current prices.
# Responses models: inputUsdPerMillion / outputUsdPerMillion (positive numbers).
# Fixed authored speech model: maxAuthoredClipUsd (verified conservative bound,
# at most $1; must cover the longest allowed text and the fixed Ash settings).
# No invented pricing defaults. Missing prices deny generation.
PILOT_MODEL_PRICING_JSON=

# Deployed survey records must use an attached PRIVATE Vercel Blob store.
# Never expose this token or the owner/session secrets through VITE_ variables.
BLOB_READ_WRITE_TOKEN=
