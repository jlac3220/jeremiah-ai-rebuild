{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/**/*.mjs": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/voice-audition.html",
      "has": [
        {
          "type": "host",
          "value": "pilot.jeremiah.app"
        }
      ],
      "destination": "/#pilot",
      "permanent": false
    }
  ]
}
