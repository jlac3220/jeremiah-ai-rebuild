+  textFaint: "#64748b",
+
+  checkpointBg: "#fff7ed",
+  checkpointBorder: "#fed7aa",
+  checkpointTextDark: "#7c2d12",
+  checkpointTextMid: "#9a3412",
+
+  masteredBg: "#ecfdf5",
+  masteredText: "#047857",
+
+  reviewBg: "#ffedd5",
+  reviewText: "#9a3412",
