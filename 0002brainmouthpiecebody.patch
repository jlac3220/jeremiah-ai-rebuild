+  primaryGradient: "linear-gradient(135deg, #0b1228 0%, #16233b 55%, #1f2f4b 100%)",
+
+  cardBg: "#ffffff",
+  cardBorder: "#e2e8f0",
+  cardShadow: "0 12px 36px rgba(15, 23, 42, 0.08)",
+
